# syntax=docker/dockerfile:1
FROM golang:1.26.4-alpine AS build
WORKDIR /src
COPY deploy/dockerfiles/go.work.workspace ./go.work
COPY gen/go gen/go
COPY ui/drive ui/drive
COPY ui/docs ui/docs
COPY ui/tables ui/tables
COPY ui/presentations ui/presentations
COPY ui/projects ui/projects
COPY ui/office-ai ui/office-ai
COPY ui/office-shell ui/office-shell
COPY services/platform services/platform
COPY services/license services/license
WORKDIR /src/services/platform
RUN go build -o /out/workspace ./cmd/workspace

FROM alpine:3.20
RUN apk add --no-cache wget
COPY --from=build /out/workspace /usr/local/bin/era-workspace
EXPOSE 8170
ENTRYPOINT ["/usr/local/bin/era-workspace"]
