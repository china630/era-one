# syntax=docker/dockerfile:1
FROM rust:1.88-bookworm AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
COPY deploy/dockerfiles/Cargo.workspace.tables-engine.toml ./Cargo.toml
COPY Cargo.lock ./
COPY crates/era-tables-core crates/era-tables-core
COPY crates/era-office-storage crates/era-office-storage
COPY services/platform/tables-engine services/platform/tables-engine
RUN cargo build --release -p era-tables-engine

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/era-tables-engine /usr/local/bin/era-tables-engine
EXPOSE 8143
ENTRYPOINT ["/usr/local/bin/era-tables-engine"]
