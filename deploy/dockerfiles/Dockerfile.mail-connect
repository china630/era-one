# syntax=docker/dockerfile:1
FROM golang:1.26.4-alpine AS build
WORKDIR /src
COPY gen/go gen/go
COPY services/platform services/platform
COPY services/license services/license
COPY services/comms/internal/httpauth services/comms/internal/httpauth
COPY services/comms/internal/imapclient services/comms/internal/imapclient
COPY services/comms/mail-connect services/comms/mail-connect
WORKDIR /src/services/comms/mail-connect
RUN go build -o /out/mail-connect-api ./cmd/mail-connect-api

FROM alpine:3.20
COPY --from=build /out/mail-connect-api /usr/local/bin/era-mail-connect-api
EXPOSE 8250
ENTRYPOINT ["/usr/local/bin/era-mail-connect-api"]
