# syntax=docker/dockerfile:1
FROM golang:1.26.4-alpine AS build
WORKDIR /src
COPY gen/go gen/go
COPY services/platform services/platform
COPY services/license services/license
COPY services/comms/internal/httpauth services/comms/internal/httpauth
COPY services/comms/chat services/comms/chat
WORKDIR /src/services/comms/chat
RUN go build -o /out/chat-api ./cmd/chat-api

FROM alpine:3.20
COPY --from=build /out/chat-api /usr/local/bin/era-chat-api
EXPOSE 8260
ENTRYPOINT ["/usr/local/bin/era-chat-api"]
