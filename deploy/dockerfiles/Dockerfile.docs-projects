# syntax=docker/dockerfile:1
FROM golang:1.26.4-alpine AS build
WORKDIR /src
COPY deploy/dockerfiles/go.work.office ./go.work
COPY gen/go gen/go
COPY ui/drive ui/drive
COPY ui/docs ui/docs
COPY services/platform services/platform
COPY services/license services/license
WORKDIR /src/services/platform
RUN go build -o /out/docs-projects ./cmd/docs-projects

FROM alpine:3.20
RUN apk add --no-cache wget
COPY --from=build /out/docs-projects /usr/local/bin/era-docs-projects
EXPOSE 8145
ENTRYPOINT ["/usr/local/bin/era-docs-projects"]
