# syntax=docker/dockerfile:1
FROM golang:1.26.4-alpine AS build
WORKDIR /src
COPY deploy/dockerfiles/go.work.migration ./go.work
COPY services/comms/internal/imapclient services/comms/internal/imapclient
COPY services/comms/migration services/comms/migration
COPY services/platform services/platform
WORKDIR /src/services/comms/migration
RUN go build -o /out/migration-api ./cmd/migration-api

FROM alpine:3.20
COPY --from=build /out/migration-api /usr/local/bin/era-migration-api
EXPOSE 8350
ENTRYPOINT ["/usr/local/bin/era-migration-api"]
