# Partner / IceWarp lab overlay (copy → deploy/comms-partner.env; never commit secrets)
# Usage:
#   docker compose -f deploy/docker-compose.comms.yml \
#     -f deploy/docker-compose.comms.partner.yml \
#     --env-file deploy/comms-partner.env up -d

# --- ERA Mail Moderation (C-MM-H) ---
ERA_MM_PUBLIC_BASE=http://127.0.0.1:8360
ERA_MM_LOCAL_DOMAINS=company.local
# IceWarp / MTA SMTP after Approve (host:port). Empty = in-memory upstream.
ERA_MM_UPSTREAM=
# Moderator notification SMTP (defaults to ERA_MM_UPSTREAM if empty).
ERA_MM_NOTIFY_SMTP=
ERA_MM_POSTGRES_DSN=postgres://era:era_dev_only@postgres:5432/era?sslmode=disable
# Optional LDAP snapshot JSON path inside container / host bind.
ERA_MM_LDAP_JSON=
# Lab script host check (scripts/run-comms-mm-icewarp-lab.ps1).
ERA_MM_ICEWARP_HOST=

# --- Bridge / Migration (existing) ---
ERA_BRIDGE_UPSTREAM_ICEWARP_BASE_URL=
ERA_BRIDGE_UPSTREAM_ROUTES=
ERA_MIG_SOURCE_IMAP_HOST=
ERA_MIG_TARGET_IMAP_HOST=
